{
  "name": "fr.gouv.medicaments.rest",
  "version": "1.7.0",
  "description": "API REST pour la base de données publique des médicaments du gouvernement français",
  "main": "src/index.js",
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "download-data": "node src/scripts/download-initial-data.js",
    "export-search-indexes": "node src/scripts/export-search-indexes.js",
    "export-corpus-documents": "node src/scripts/export-corpus-documents.js",
    "benchmark:csv-loading": "node --expose-gc scripts/benchmark/benchmark-csv-loading.js",
    "benchmark:search-pagination": "node --expose-gc scripts/benchmark/benchmark-search-pagination.js",
    "benchmark:vet-xml": "node --expose-gc scripts/benchmark/vet-xml-parsers.js",
    "analyze:interning": "node scripts/benchmark/analyze-interning-candidates.js",
    "measure:bdpm-resident": "node --expose-gc scripts/memory/measure-interning-resident.js",
    "stress:prod": "node scripts/benchmark/stress-test-prod.js",
    "audit:ansm-dispo": "node scripts/audit/compare-ansm-export-vs-bdpm-dispo.js",
    "audit:ansm-fiches": "node scripts/audit/probe-ansm-fiche-bot.js",
    "audit:ema-monitoring": "node scripts/audit/compare-ema-additional-monitoring-vs-bdpm.js",
    "test": "jest",
    "test:serial": "jest --runInBand",
    "test:integration": "RUN_SLOW_TESTS=1 jest --runInBand tests/api.test.js tests/coherence.test.js tests/veterinaires.test.js",
    "test:all": "RUN_SLOW_TESTS=1 jest --runInBand"
  },
  "dependencies": {
    "@yoch/frozenminisearch": "^1.12.0",
    "7zip-bin": "^5.2.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fs-extra": "^11.4.1",
    "helmet": "^8.3.0",
    "saxes": "^6.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.11.2",
    "jest": "^30.5.2",
    "knip": "^6.41.0",
    "supertest": "^7.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "keywords": [
    "medicaments",
    "api",
    "rest",
    "france",
    "gouv"
  ],
  "author": "",
  "license": "MIT"
}
