# =============================================================================
# Profil « bot allégé » — copier vers .env
# =============================================================================

PORT=3000

# restart = PM2 redémarre le process après MAJ données
RELOAD_STRATEGY=restart

# Préchauffage au chargement/rechargement : legacy (défaut, 0 Mo additionnel), structured (B1) ou concepts (B2).
# Ne restreint pas l'autorisation serveur d'appeler un mode via ?mode=legacy|structured|concepts.
SEARCH_WARMUP_MODE=legacy

# false = sans avis HAS SMR/ASMR (~2 fichiers lourds + 2 index en moins, pas de téléchargement HAS)
#   GET /avis-smr et /avis-asmr → HTTP 410 ; fiche /specialites/:cis sans champs avis_*
LOAD_HAS_AVIS=false

# false = sans MITM (pas de CIS_MITM.txt ni index) — GET /interet-therapeutique-majeur → HTTP 410
LOAD_MITM=false

# true = omet en RAM statut_admin/date_declaration/agrement_collectivite (présentations),
# reference_dosage/numero_ordre (compositions), num_amm/date_amm (vet) — sans lien avec LOAD_HAS_AVIS
CORPUS_LIGHT_PROFILE=true

SEARCH_HYDRATE_RELATED_LIMIT=50
DETAIL_HYDRATE_RELATED_LIMIT=0

# 1 à 596 heures : au-delà, les timers Node débordent.
# Le délai est compté après la fin du rafraîchissement précédent.
BDPM_CHECK_INTERVAL_HOURS=72
VET_CHECK_INTERVAL_HOURS=72

# Vétérinaire après app.listen — API BDPM disponible avant le pic vet
VET_LOAD_DEFERRED=true
# Pause (ms) avant chargement vet, après le chargement BDPM
VET_LOAD_DELAY_MS=2000

# Mise au point locale uniquement : ignoré si NODE_ENV=production.
# Déclenche un seul global.gc() après chargement vet si Node est lancé avec --expose-gc.
POST_LOAD_GC=false

# -----------------------------------------------------------------------------
# Profil « complet » (endpoints avis HAS) — remplacer les lignes ci-dessus
# -----------------------------------------------------------------------------
# LOAD_HAS_AVIS=true
# VET_LOAD_DEFERRED=true
# VET_LOAD_DELAY_MS=2000

# -----------------------------------------------------------------------------
# Exécutable compilé (npm run build:aot, voir docs/BUN_AOT.md)
# -----------------------------------------------------------------------------
# Obligatoire pour l'exécutable (sous Node : <dépôt>/data par défaut). Chemin absolu.
# DATA_DIR=/srv/medicaments/data
# VET_DATA_DIR=/srv/medicaments/data/veterinaires
# 7za d'extraction de l'archive vétérinaire : par défaut celui de 7zip-bin sous Node,
# et le 7za posé à côté de l'exécutable compilé.
# SEVEN_ZIP_PATH=/usr/bin/7za
