# Port de l'application (par défaut 3000)
PORT=3000

# in-process = reload dans le même processus | restart = exit(0) pour laisser PM2/systemd redémarrer
RELOAD_STRATEGY=in-process

# GC explicite entre BDPM et vet (nécessite --expose-gc dans NODE_OPTIONS)
GC_BETWEEN_LOAD_PHASES=true

# false = ne pas charger les avis HAS SMR/ASMR en RAM (~18 Mo de TSV)
LOAD_HAS_AVIS=true

# Limite d'éléments liés renvoyés par CIS dans /api/medicaments/search
SEARCH_HYDRATE_RELATED_LIMIT=50

# Seuils /health (Mo RSS)
MEMORY_ALERT_RSS_MB=450
MEMORY_CRITICAL_RSS_MB=480

# Logs des phases mémoire au chargement
MEMORY_PROFILE=false

# Garde-fous Node (après optimisation — ne réduit pas la RAM structurelle)
# NODE_OPTIONS=--max-old-space-size=384
