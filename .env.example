# =============================================================================
# Profil « bot allégé » — copier vers .env
# =============================================================================

PORT=3000

# restart = PM2 redémarre le process après MAJ données
RELOAD_STRATEGY=restart

# false = sans avis HAS SMR/ASMR (~2 fichiers lourds + 2 index en moins, pas de téléchargement HAS)
#   GET /avis-smr et /avis-asmr → HTTP 410 ; fiche /specialites/:cis sans champs avis_*
LOAD_HAS_AVIS=false

# false = sans MITM (pas de CIS_MITM.txt ni index) — GET /interet-therapeutique-majeur → HTTP 410
LOAD_MITM=false

SEARCH_HYDRATE_RELATED_LIMIT=50
DETAIL_HYDRATE_RELATED_LIMIT=0

BDPM_CHECK_INTERVAL_HOURS=72
VET_CHECK_INTERVAL_HOURS=72

# Vétérinaire après app.listen — API BDPM disponible avant le pic vet
VET_LOAD_DEFERRED=true
# Pause (ms) avant chargement vet — laisser la RSS BDPM redescendre (~15 s) avant le pic vet
VET_LOAD_DELAY_MS=15000

# -----------------------------------------------------------------------------
# Profil « complet » (endpoints avis HAS) — remplacer les lignes ci-dessus
# -----------------------------------------------------------------------------
# LOAD_HAS_AVIS=true
# VET_LOAD_DEFERRED=true
# VET_LOAD_DELAY_MS=15000
