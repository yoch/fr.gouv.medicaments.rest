# Environnement de l'exécutable compilé (/etc/medicaments-api.env, lu par l'unité systemd).
# NODE_ENV est fixé à « production » au build (npm run build:aot) : inutile ici.

PORT=3100
RELOAD_STRATEGY=restart

# Obligatoires pour l'exécutable : chemins absolus, accessibles en écriture
# (téléchargements, meta.json).
DATA_DIR=/srv/medicaments/data
VET_DATA_DIR=/srv/medicaments/data/veterinaires

# Par défaut, 7za est cherché à côté de l'exécutable (copié par build:aot).
# SEVEN_ZIP_PATH=/usr/bin/7za

# Même profil que ecosystem.config.js (Node).
CORPUS_LIGHT_PROFILE=true
VET_LOAD_DEFERRED=true
VET_LOAD_DELAY_MS=2000
